# Environment
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database - локальный PostgreSQL
DB_URL=postgresql+asyncpg://user:password@localhost:5432/bitrix_messenger
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis - локальный Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# RabbitMQ - локальный RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=bitrix_messenger

# MinIO/S3 - локальный MinIO (опционально)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bitrix-messenger
MINIO_SECURE=false

# Security
SECURITY_SECRET_KEY=your-secret-key-change-in-production
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=7

# Telegram
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/channels/telegram
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# WhatsApp
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-verify-token

# Bitrix24
BITRIX_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/bitrix
BITRIX_WEBHOOK_SECRET=your-bitrix-webhook-secret

# Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO
